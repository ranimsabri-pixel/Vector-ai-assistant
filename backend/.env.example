# ============================================================
# Vector Backend - Environment Variables (EXAMPLE)
# Copy this file to .env and fill in real values
# ============================================================

# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/dbname

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_CHAT=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_EMBED=text-embedding-3-small

# --- Auth ---
SECRET_KEY=change-me-to-a-random-base64-string-of-48-bytes-or-more
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- CORS (autoriser le frontend à appeler le backend) ---
CORS_ORIGINS=http://localhost:3000

# --- Recherche web (Tavily) ---
TAVILY_API_KEY=tvly-your-api-key-here

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_DATASET_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=10

# --- Logs ---
LOG_LEVEL=INFO

# --- Démo publique Render (S5 J55) ---
# Laisser à false en dev/CI (sinon pytest/e2e se font bloquer par les
# limites, ex: 5 inscriptions/jour). Render production : true.
RATE_LIMIT_ENABLED=false
DEMO_DISABLED=false
DEMO_ACCOUNT_EMAIL=demo@vector.ai
DEMO_ACCOUNT_PASSWORD=VectorDemo2026!